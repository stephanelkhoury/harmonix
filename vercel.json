{
  "version": 2,
  "name": "harmonix",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/backend/(.*)",
      "dest": "/backend/server.js"
    },
    {
      "src": "/api/server/(.*)", 
      "dest": "/server/index.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/backend/server.js"
    },
    {
      "src": "/health",
      "dest": "/backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "MONGODB_URI": "@mongodb-uri",
    "MONGO_URL": "@mongodb-uri", 
    "JWT_SECRET": "@jwt-secret",
    "PYTHON_SERVICE_URL": "@python-service-url",
    "REACT_APP_BACKEND_URL": "",
    "REACT_APP_SERVER_URL": "",
    "REACT_APP_PYTHON_SERVICE_URL": "@python-service-url"
  },
  "functions": {
    "backend/server.js": {
      "maxDuration": 30
    },
    "server/index.js": {
      "maxDuration": 30
    }
  },
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  }
}
